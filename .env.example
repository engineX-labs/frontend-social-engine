# Copiar a `.env.local` (está en .gitignore).

# Clave pública de Clerk (pk_test_... en desarrollo, pk_live_... en producción). NO es secreta, pero
# es obligatoria: sin ella la app muestra un aviso y no deja entrar. La escribe
# `npx -y clerk@latest init` o se copia de Clerk > API keys. La clave secreta (sk_...) NO va en el front.
VITE_CLERK_PUBLISHABLE_KEY=

# URL del backend (admite prefijo, p. ej. https://api.x.com/v1). Sin esto el front usa datos de
# ejemplo (MSW). En local: el backend corre con `uvicorn app.main:app --port 8000`.
# VITE_API_URL=http://localhost:8000

# Con VITE_API_URL, deja el chat simulado: POST /api/chat todavía no existe en el backend (S4).
# VITE_MOCK_CHAT=true

# Muestra publicar y programar (Nueva publicación, borradores y programadas en el calendario). Con el
# backend real, también tiene que estar prendido PUBLICACION_HABILITADA en su .env; si no, las rutas
# responden 404 y el front esconde todo igual.
# VITE_PUBLICACION_HABILITADA=true
