# Copiar a `.env.local` (está en .gitignore). Todo es opcional: sin nada, la app usa datos de ejemplo.

# URL del backend (admite prefijo, p. ej. https://api.x.com/v1). Sin esto el front usa mocks (MSW).
# En local: el backend corre con `uvicorn app.main:app --port 8000`.
# VITE_API_URL=http://localhost:8000

# Con VITE_API_URL, deja el chat simulado: POST /api/chat todavía no existe en el backend (S4).
# VITE_MOCK_CHAT=true

# Token de desarrollo para el backend local. SOLO se lee en `npm run dev` (Vite lo elimina del
# build). Se genera con el mismo secreto que el backend:
#   SUPABASE_JWT_SECRET=<el del .env del backend> node scripts/token-dev.mjs <uuid del usuario>
# El uuid es el que se vinculó al comercio con `python -m app.admin crear-comercio --usuario`.
# No pegar acá tokens de producción: es un archivo de ejemplo.
# VITE_DEV_TOKEN=
